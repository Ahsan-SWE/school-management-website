# Application
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_NAME=School Platform
NEXT_PUBLIC_API_URL=http://localhost:3001
WEB_ORIGIN=http://localhost:3000
API_PORT=3001
LOG_LEVEL=info

# Supabase local defaults. Replace keys with values printed by `pnpm supabase:status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Legacy alias kept for the current local setup. It may contain the same publishable key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-key

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
SUPABASE_ANON_KEY=replace-with-local-publishable-key

# Server-only. Never expose this variable to browser code.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-secret-key

# Google login is hidden until the provider is configured.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# PostgreSQL
# Runtime connections should use a pooler in hosted environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Prisma migrations must use a direct connection.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Create a separate shadow database before enabling this.
# SHADOW_DATABASE_URL=

# Optional services
REDIS_URL=
SENTRY_DSN=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_KMS_KEY_ARN=
