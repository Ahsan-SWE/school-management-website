# Application
NODE_ENV=development
APP_ENV=development
NEXT_PUBLIC_APP_NAME=School Platform
NEXT_PUBLIC_API_URL=http://localhost:3001
API_PORT=3001
LOG_LEVEL=info

# Supabase local defaults. Replace keys with values printed by `pnpm supabase:start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# PostgreSQL
# Runtime connections should use a pooler in hosted environments.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Prisma migrations must use a direct connection.
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
SHADOW_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres_shadow

# Optional services
REDIS_URL=
SENTRY_DSN=
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_KMS_KEY_ARN=
